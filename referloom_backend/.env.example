# ==============================================================================
# Referloom Backend - Environment Variable Template
# ==============================================================================
# Copy this file to '.env' and populate with your local/testing configuration.
# DO NOT commit '.env' or expose production secrets to Git.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/referloom?schema=public

# Authentication (JWT)
# Generate a secure random string (at least 32 characters)
JWT_SECRET=change_this_to_a_secure_random_secret_in_development_or_production

# Google Gemini AI (Optional - falls back to deterministic matching if absent)
GEMINI_API_KEY=

# Cloudinary CDN (For profile pictures and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (Nodemailer SMTP for OTP verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
