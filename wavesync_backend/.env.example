# ==============================================================================
# WaveSync Backend - Environment Variable Template
# ==============================================================================
# Copy this file to '.env' and populate with your local/testing configuration.
# DO NOT commit '.env' or expose production secrets to Git.
# ==============================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wavesync?schema=public

# Authentication (JWT)
# Generate a secure random string (at least 32 characters)
JWT_SECRET=change_this_to_a_secure_random_secret_in_development_or_production

# Google Gemini AI (Optional - falls back to deterministic matching if absent)
GEMINI_API_KEY=

# Cloudinary CDN (For profile pictures and document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (Nodemailer SMTP for OTP verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Build-to-Earn Review Signing (Ed25519)
# Generate a keypair once in Node:
#   const { generateKeyPairSync } = await import('crypto');
#   const { privateKey, publicKey } = generateKeyPairSync('ed25519');
#   console.log('PRIV:', privateKey.export({ type: 'pkcs8', format: 'der' }).toString('base64url'));
#   console.log('PUB:',  publicKey.export({  type: 'spki',  format: 'der' }).toString('base64url'));
# Store ONLY in .env — never commit the private key.
WAVESYNC_SIGNING_PRIVATE_KEY=
WAVESYNC_SIGNING_PUBLIC_KEY=
